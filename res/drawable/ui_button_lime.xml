<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#ff70d6f5" />
            <corners android:radius="14.0dip" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:startColor="#ff70d6f5" android:endColor="#ff70d6f5" android:angle="0.0" />
            <corners android:radius="14.0dip" />
        </shape>
    </item>
</selector>