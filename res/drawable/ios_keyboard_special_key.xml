<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#ffadb2ba" />
            <corners android:radius="6.0dip" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#ffbec3cb" />
            <corners android:radius="6.0dip" />
            <stroke android:width="1.0dip" android:color="#ff7f8790" />
        </shape>
    </item>
</selector>